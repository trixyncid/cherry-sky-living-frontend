# Backend API base URL (no trailing slash).
# Used by the /api/backend proxy and server-side session checks.
#
# Development (local Elysia backend on port 8000):
API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production (set in Vercel — API_URL is server-only, no rebuild to change):
# API_URL=https://cherry-sky-kost-backend-production.up.railway.app
#
# Staging:
# API_URL=https://api-staging.cherryskykost.com
#
# Browser traffic always goes through /api/backend on the frontend origin so
# session cookies stay first-party. API_URL tells the proxy where to forward.

# Public contact WhatsApp (digits or leading 0 local ID format).
# Used by catalogue CTAs, footer, contact/about pages, and inquiry dialogs.
NEXT_PUBLIC_WHATSAPP_NUMBER=08116359119

# Click-to-call number (optional). Falls back to NEXT_PUBLIC_WHATSAPP_NUMBER.
# NEXT_PUBLIC_CONTACT_PHONE=08116359119

# Analytics (optional — nothing loads until one is set). See src/lib/analytics.ts.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cherryskykost.com
