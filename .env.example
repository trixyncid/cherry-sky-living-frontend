# Backend API base URL (no trailing slash).
# Used by the /api/backend proxy and server-side session checks.
#
# Development (local Elysia backend on port 8000):
API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production (set in Vercel — API_URL is server-only, no rebuild to change):
# API_URL=https://cherry-sky-kost-backend-production.up.railway.app
#
# Staging:
# API_URL=https://api-staging.cherryskykost.com
#
# Browser traffic always goes through /api/backend on the frontend origin so
# session cookies stay first-party. API_URL tells the proxy where to forward.

# The public contact / WhatsApp number is hardcoded in src/lib/contact.ts.

# Shared with the backend (same value on Vercel and Railway). Lets the API
# proxy vouch for each visitor's IP so rate limits apply per visitor.
# Generate with: openssl rand -base64 48
# PROXY_SHARED_SECRET=

# Image hosts allowed through the Next.js image optimizer (the Spaces bucket
# photos come from), comma-separated. Defaults to the development bucket.
# STORAGE_IMAGE_HOSTS=mybucket.sgp1.digitaloceanspaces.com,mybucket.sgp1.cdn.digitaloceanspaces.com

# Analytics (optional — nothing loads until one is set). See src/lib/analytics.ts.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cherryskykost.com
